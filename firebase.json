{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/about.html", "destination": "https://familyai.thienquangtech.com/About", "type": 301 },
      { "source": "/service.html", "destination": "https://familyai.thienquangtech.com/Service", "type": 301 },
      { "source": "/contact.html", "destination": "https://familyai.thienquangtech.com/Contact", "type": 301 },
      { "source": "/@(About|about)", "destination": "https://familyai.thienquangtech.com/About", "type": 301 },
      { "source": "/@(Service|service)", "destination": "https://familyai.thienquangtech.com/Service", "type": 301 },
      { "source": "/@(Contact|contact)", "destination": "https://familyai.thienquangtech.com/Contact", "type": 301 },
      { "source": "**", "destination": "https://familyai.thienquangtech.com/", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
